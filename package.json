{
  "name": "petrol-pump-system",
  "private": true,
  "version": "1.0.1",
  "description": "Offline-First Petrol Pump Management System with Fleet Ledgers, Stock & Shift Closing",
  "author": "Antigravity Dev",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "electron electron/main.cjs",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on -t 20000 tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:pack": "vite build && electron-builder --dir",
    "build:exe": "vite build && electron-builder",
    "build:release": "vite build && electron-builder --publish always",
    "make:release": "node scripts/generate-setup.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.7.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.diyal.petrolpump",
    "productName": "Diyal Filling Station",
    "electronVersion": "44.7.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "CS24786",
        "repo": "Petrol-Pump"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Diyal Filling Station",
      "artifactName": "Diyal-Filling-Station-Setup-${version}.${ext}"
    }
  }
}
